{
  "name": "@uazgraduatecollege/azgrad-common-ui",
  "version": "2.1.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uazgraduatecollege/azgrad-common-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Common UI components for UArizona Graduate College web projects. Build in React JS.",
  "source": [
    "src/index.js"
  ],
  "main": "dist/main.js",
  "module": "dist/module.js",
  "files": ["dist"],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "parcel build",
    "example": "parcel --dist-dir .example src/example/example.html",
    "lint": "eslint .",
    "prepare": "parcel build",
    "test": "vitest run"
  },
  "contributors": [
    "Patrick Barabe <pbarabe@arizona.edu>"
  ],
  "bugs": {
    "url": "https://gitlab.grad.arizona.edu/web-utils/ui/azgrad-common-ui/-/issues",
    "email": "help@grad.arizona.edu"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "parcel": "^2.16.4",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
