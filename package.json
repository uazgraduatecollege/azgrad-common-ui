{
  "name": "@uazgraduatecollege/azgrad-common-ui",
  "version": "2.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uazgraduatecollege/azgrad-common-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Common UI components for UArizona Graduate College web projects. Build in React JS.",
  "source": [
    "src/index.js"
  ],
  "main": "dist/main.js",
  "module": "dist/module.js",
  "targets": {
    "example": {
      "source": "src/example/example.html",
      "distDir": ".example",
      "context": "browser"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "parcel build",
    "example": "parcel serve --target example",
    "preexample": "rm -rf .parcel-cache .example",
    "lint": "eslint .",
    "prepare": "parcel build",
    "test": "vitest run"
  },
  "contributors": [
    "Patrick Barabe <pbarabe@arizona.edu>",
    "Annie Prisbrey <abrisbrey@arizona.edu>",
    "Ratish Shrestha <ratish@arizona.edu>"
  ],
  "bugs": {
    "url": "https://gitlab.grad.arizona.edu/web-utils/ui/azgrad-common-ui/-/issues",
    "email": "help@grad.arizona.edu"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "neostandard": "^0.13.0",
    "parcel": "^2.16.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
